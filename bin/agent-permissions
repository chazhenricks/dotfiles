#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const os = require('os');

const GENERATED_START = '# BEGIN GENERATED BY agent-permissions';
const GENERATED_END = '# END GENERATED BY agent-permissions';
const SUPPORTED_AGENTS = ['codex', 'claude'];
const ROOT = '/Users/chaz.henricks/dotfiles';
const POLICY_PATH = path.join(ROOT, 'agents', 'agent-permissions.md');
const CODEX_CONFIG_PATH = path.join(os.homedir(), '.codex', 'config.toml');
const CODEX_RULES_PATH = path.join(os.homedir(), '.codex', 'rules', 'agent-permissions.rules');
const CLAUDE_SETTINGS_PATH = path.join(os.homedir(), '.claude', 'settings.json');
const EXACT_CLAUDE_COMMANDS = new Set(['pwd', 'env', 'node --version']);

function main() {
  const agent = parseAgentArg(process.argv.slice(2));
  const policy = readPolicy(POLICY_PATH);
  const agents = agent === 'all' ? SUPPORTED_AGENTS : [agent];

  for (const currentAgent of agents) {
    if (currentAgent === 'codex') {
      applyCodex(policy);
      continue;
    }

    if (currentAgent === 'claude') {
      applyClaude(policy);
      continue;
    }

    throw new Error(`Unsupported agent: ${currentAgent}`);
  }
}

function parseAgentArg(args) {
  if (args.includes('--help') || args.includes('-h')) {
    printHelp();
    process.exit(0);
  }

  const agentFlagIndex = args.indexOf('--agent');
  const agentEqualsArg = args.find((arg) => arg.startsWith('--agent='));
  const agent = agentEqualsArg ? agentEqualsArg.slice('--agent='.length) : args[agentFlagIndex + 1];

  if (!agentFlagIndexIsValid(agentFlagIndex, agentEqualsArg, args) || !['codex', 'claude', 'all'].includes(agent)) {
    printHelp();
    process.exitCode = 1;
    throw new Error('Expected --agent codex, --agent claude, or --agent all.');
  }

  return agent;
}

function agentFlagIndexIsValid(agentFlagIndex, agentEqualsArg, args) {
  if (agentEqualsArg) {
    return agentEqualsArg.length > '--agent='.length;
  }

  return agentFlagIndex >= 0 && Boolean(args[agentFlagIndex + 1]);
}

function printHelp() {
  console.log(`Usage: agent-permissions --agent <codex|claude|all>`);
}

function readPolicy(policyPath) {
  const content = fs.readFileSync(policyPath, 'utf8');
  const match = content.match(/```json\s*([\s\S]*?)\s*```/m);

  if (!match) {
    throw new Error(`No fenced json policy block found in ${policyPath}`);
  }

  const policy = JSON.parse(match[1]);
  validatePolicy(policy);
  return policy;
}

function validatePolicy(policy) {
  assertArray(policy.agents, 'agents');
  assertArray(policy.sensitiveReadDeny.absolutePaths, 'sensitiveReadDeny.absolutePaths');
  assertArray(policy.sensitiveReadDeny.workspaceGlobs, 'sensitiveReadDeny.workspaceGlobs');
  assertArray(policy.sensitiveReadDeny.claudeReadRules, 'sensitiveReadDeny.claudeReadRules');
  assertArray(policy.readTools.claude, 'readTools.claude');
  assertArray(policy.writeTools.claudeAsk, 'writeTools.claudeAsk');
  assertCommandPrefixes(policy.readCommandPrefixes, 'readCommandPrefixes');
  assertCommandPrefixes(policy.writeCommandPrefixes, 'writeCommandPrefixes');
}

function assertArray(value, name) {
  if (!Array.isArray(value)) {
    throw new Error(`Policy field ${name} must be an array.`);
  }
}

function assertCommandPrefixes(value, name) {
  assertArray(value, name);

  for (const prefix of value) {
    if (!Array.isArray(prefix) || prefix.length === 0 || prefix.some((part) => typeof part !== 'string' || part.length === 0)) {
      throw new Error(`Policy field ${name} must contain non-empty string arrays.`);
    }
  }
}

function applyCodex(policy) {
  ensureDirectory(path.dirname(CODEX_CONFIG_PATH));
  ensureDirectory(path.dirname(CODEX_RULES_PATH));

  const existingConfig = readFileIfExists(CODEX_CONFIG_PATH);
  const updatedConfig = updateCodexConfig(existingConfig, policy);
  writeIfChanged(CODEX_CONFIG_PATH, updatedConfig);

  const rules = renderCodexRules(policy);
  writeIfChanged(CODEX_RULES_PATH, rules);
  console.log(`Updated Codex permissions: ${CODEX_CONFIG_PATH}`);
  console.log(`Updated Codex rules: ${CODEX_RULES_PATH}`);
}

function updateCodexConfig(content, policy) {
  const withoutGenerated = stripGeneratedBlock(content);
  const lines = withoutGenerated.split('\n');
  const firstTableIndex = lines.findIndex((line) => /^\s*\[/.test(line));
  const headerLines = firstTableIndex === -1 ? lines : lines.slice(0, firstTableIndex);
  const tableLines = firstTableIndex === -1 ? [] : lines.slice(firstTableIndex);
  const managedTopLevelKeys = new Set(['approval_policy', 'approvals_reviewer', 'default_permissions', 'sandbox_mode']);
  const cleanedHeader = headerLines.filter((line) => !isManagedTopLevelLine(line, managedTopLevelKeys));
  const profileName = policy.codex.profileName;
  const generatedHeader = [
    'approval_policy = "on-request"',
    'approvals_reviewer = "user"',
    `default_permissions = ${tomlString(profileName)}`,
  ];
  const generatedBlock = renderCodexPermissionsBlock(policy);
  const sections = [
    generatedHeader.join('\n'),
    trimOuterBlankLines(cleanedHeader.join('\n')),
    trimOuterBlankLines(tableLines.join('\n')),
    generatedBlock,
  ].filter(Boolean);

  return `${sections.join('\n\n')}\n`;
}

function isManagedTopLevelLine(line, keys) {
  const match = line.match(/^\s*([A-Za-z0-9_\-]+)\s*=/);
  return Boolean(match && keys.has(match[1]));
}

function renderCodexPermissionsBlock(policy) {
  const profileName = policy.codex.profileName;
  const profileDescription = policy.codex.profileDescription;
  const absoluteDenyEntries = policy.sensitiveReadDeny.absolutePaths.map((denyPath) => `${tomlString(denyPath)} = "deny"`);
  const workspaceDenyEntries = policy.sensitiveReadDeny.workspaceGlobs.map((glob) => `${tomlString(glob)} = "deny"`);
  const lines = [
    `${GENERATED_START} (codex permissions)`,
    `[permissions.${profileName}]`,
    `description = ${tomlString(profileDescription)}`,
    '',
    `[permissions.${profileName}.filesystem]`,
    'glob_scan_max_depth = 4',
    '":root" = "read"',
    ...absoluteDenyEntries,
    '',
    `[permissions.${profileName}.filesystem.":workspace_roots"]`,
    ...workspaceDenyEntries,
    `${GENERATED_END} (codex permissions)`,
  ];

  return lines.join('\n');
}

function renderCodexRules(policy) {
  const readRules = policy.readCommandPrefixes.map((prefix) => renderPrefixRule(prefix, 'allow', 'Shared policy: read-only command.'));
  const writeRules = filteredWritePrefixes(policy).map((prefix) => renderPrefixRule(prefix, 'prompt', 'Shared policy: write-capable command.'));
  return [
    '# Generated by agent-permissions. Do not edit by hand.',
    `# Source: ${POLICY_PATH}`,
    ...readRules,
    ...writeRules,
    '',
  ].join('\n');
}

function renderPrefixRule(prefix, decision, justification) {
  const pattern = `[${prefix.map((part) => JSON.stringify(part)).join(', ')}]`;
  return `prefix_rule(pattern=${pattern}, decision=${JSON.stringify(decision)}, justification=${JSON.stringify(justification)})`;
}

function applyClaude(policy) {
  ensureDirectory(path.dirname(CLAUDE_SETTINGS_PATH));
  const existingSettings = readJsonIfExists(CLAUDE_SETTINGS_PATH);
  const updatedSettings = updateClaudeSettings(existingSettings, policy);
  writeJsonIfChanged(CLAUDE_SETTINGS_PATH, updatedSettings);
  console.log(`Updated Claude permissions: ${CLAUDE_SETTINGS_PATH}`);
}

function updateClaudeSettings(settings, policy) {
  const nextSettings = deepClone(settings);
  const permissions = deepClone(nextSettings.permissions || {});
  const sandbox = deepClone(nextSettings.sandbox || {});

  permissions.defaultMode = 'default';
  permissions.disableAutoMode = 'disable';
  permissions.disableBypassPermissionsMode = 'disable';
  permissions.allow = uniqueSorted([
    ...policy.readTools.claude,
    ...policy.readCommandPrefixes.map(toClaudeBashRule),
  ]);
  permissions.ask = uniqueSorted([
    ...policy.writeTools.claudeAsk,
    ...filteredWritePrefixes(policy).map(toClaudeBashRule),
  ]);
  permissions.deny = uniqueSorted(policy.sensitiveReadDeny.claudeReadRules);

  sandbox.enabled = true;
  sandbox.autoAllowBashIfSandboxed = false;

  nextSettings.permissions = permissions;
  nextSettings.sandbox = sandbox;
  return nextSettings;
}

function filteredWritePrefixes(policy) {
  return policy.writeCommandPrefixes.filter((writePrefix) => !policy.readCommandPrefixes.some((readPrefix) => isStrictPrefix(writePrefix, readPrefix)));
}

function isStrictPrefix(candidatePrefix, targetPrefix) {
  if (candidatePrefix.length >= targetPrefix.length) {
    return false;
  }

  return candidatePrefix.every((part, index) => part === targetPrefix[index]);
}

function toClaudeBashRule(prefix) {
  const command = prefix.join(' ');

  if (EXACT_CLAUDE_COMMANDS.has(command)) {
    return `Bash(${command})`;
  }

  return `Bash(${command} *)`;
}

function stripGeneratedBlock(content) {
  const start = escapeRegExp(GENERATED_START);
  const end = escapeRegExp(GENERATED_END);
  const generatedBlockPattern = new RegExp(`\\n?${start}[\\s\\S]*?${end}[^\\n]*\\n?`, 'g');
  return content.replace(generatedBlockPattern, '\n');
}

function writeIfChanged(filePath, content) {
  const existing = readFileIfExists(filePath);

  if (existing === content) {
    console.log(`No change: ${filePath}`);
    return;
  }

  backupIfExists(filePath);
  fs.writeFileSync(filePath, content, 'utf8');
}

function writeJsonIfChanged(filePath, value) {
  writeIfChanged(filePath, `${JSON.stringify(value, null, 2)}\n`);
}

function readJsonIfExists(filePath) {
  const content = readFileIfExists(filePath);

  if (content.length === 0) {
    return {};
  }

  return JSON.parse(content);
}

function backupIfExists(filePath) {
  if (!fs.existsSync(filePath)) {
    return;
  }

  const backupPath = `${filePath}.bak-${timestamp()}`;
  fs.copyFileSync(filePath, backupPath);
  console.log(`Backup written: ${backupPath}`);
}

function readFileIfExists(filePath) {
  if (!fs.existsSync(filePath)) {
    return '';
  }

  return fs.readFileSync(filePath, 'utf8');
}

function ensureDirectory(directoryPath) {
  fs.mkdirSync(directoryPath, { recursive: true });
}

function tomlString(value) {
  return JSON.stringify(value);
}

function trimOuterBlankLines(value) {
  return value.replace(/^\n+/, '').replace(/\n+$/, '');
}

function uniqueSorted(values) {
  return [...new Set(values)].sort((left, right) => left.localeCompare(right));
}

function deepClone(value) {
  return JSON.parse(JSON.stringify(value));
}

function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function timestamp() {
  const now = new Date();
  const pad = (value) => String(value).padStart(2, '0');
  return [
    now.getFullYear(),
    pad(now.getMonth() + 1),
    pad(now.getDate()),
    pad(now.getHours()),
    pad(now.getMinutes()),
    pad(now.getSeconds()),
  ].join('');
}

main();
